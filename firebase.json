{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "supabase.sql", "*.txt"],
    "headers": [
      { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
      { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
      { "source": "/config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] }
    ]
  }
}
